{% extends "base.html.twig" %}

{% block body %}
    <h1>Modifier le produit : {{ product.name }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.price) }}
    {{ form_row(form.description) }}
    {{ form_row(form.image) }}
    {{ form_row(form.category) }}
    <button type="submit">Mettre à jour</button>
    {{ form_end(form) }}

    <a href="{{ path('product_list') }}">← Retour à la liste</a>
{% endblock %}