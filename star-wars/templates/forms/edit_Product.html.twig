{% extends "base.html.twig" %}

{% block body %}
<div class="form-page">
    <div class="form-card">
        <h1 class="form-title">Modify product : {{ product.name }}</h1>

        {{ form_start(form, {'attr': {'class': 'custom-form'}}) }}

            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.price) }}
                <div class="input-with-symbol">
                    {{ form_widget(form.price, {'attr': {'class': 'form-input'}}) }}
                    <span class="currency-symbol">€</span>
                </div>
                {{ form_errors(form.price) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.image) }}
            </div>

            <div class="form-group">
                {{ form_label(form.category) }}
                {{ form_widget(form.category, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.category) }}
            </div>

            <button type="submit" class="form-button">Mettre à jour</button>

        {{ form_end(form) }}

        <div class="form-actions">
            <a href="{{ path('product_list') }}" class="profile-button secondary">Product list</a>
        </div>
    </div>
</div>
{% endblock %}
