    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>C:/Users/Mael/Documents/GitHub/Star-wars-tp-Mael/star-wars/src/Controller/HomeController.php</code></li>
        <li>Your template at <code>C:/Users/Mael/Documents/GitHub/Star-wars-tp-Mael/star-wars/templates/home/index.html.twig</code></li>
    </ul>

    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <p> username: {{ app.user.username }}</p>
