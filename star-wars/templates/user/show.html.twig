{# templates/user/show.html.twig #}
{% extends "base.html.twig" %}



{% block body %}
    <div class="profile-container">
        <h1>Profil de {{ user.username }}</h1>

        <div class="info-card">
            <p><strong>ID :</strong> {{ user.id }}</p>
            <p><strong>Username :</strong> {{ user.username }}</p>
            <p><strong>Rôles :</strong> {{ user.roles|join(', ') }}</p>
            <p><strong>Panier :</strong> 
                {% if user.cart %}
                    <span class="badge badge-info">Panier #{{ user.cart.id }} ({{ user.cart.products|length }} produits)</span>
                {% else %}
                    <span class="badge badge-secondary">Pas de panier</span>
                {% endif %}
            </p>
        </div>

        {# Affichage du panier #}
        {% if user.cart and user.cart.products|length > 0 %}
            <h2>Mon panier</h2>
            <div class="table-responsive">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Prix</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in user.cart.products %}
                            <tr>
                                <td>{{ product.name }}</td>
                                <td>{{ product.price }} €</td>
                                <td>
                                    <form action="{{ path('cart_remove', {'id': product.id}) }}" method="post" onsubmit="return confirm('Retirer ce produit du panier ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('remove-from-cart-' ~ product.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Retirer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="text-end"><strong>Total :</strong></td>
                            <td colspan="2"><strong>{{ user.cart.products|reduce((total, product) => total + product.price, 0) }} €</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            
            <div class="mt-3">
                <a href="{{ path('product_list') }}" class="btn btn-primary">Continuer mes achats</a>
            </div>
            
        {% elseif user.cart %}
            <div class="alert alert-info">
                Votre panier est vide. 
                <a href="{{ path('product_list') }}" class="alert-link">Continuer mes achats</a>
            </div>
        {% endif %}

        <div class="mt-4">
            <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-warning">Modifier mon profil</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('user_index') }}" class="btn btn-secondary">← Retour à la liste</a>
            {% endif %}
        </div>
    </div>
{% endblock %}