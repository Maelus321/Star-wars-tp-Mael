{# templates/user/show.html.twig #}
{% extends "base.html.twig" %}



{% block body %}
<div class="profile-page">

    <div class="profile-card">
        <h1 class="profile-title">Profil de {{ user.username }}</h1>

        <div class="profile-info">
            <p><strong>ID :</strong> {{ user.id }}</p>
            <p><strong>Username :</strong> {{ user.username }}</p>
            <p><strong>Rôles :</strong> {{ user.roles|join(', ') }}</p>
            <p>
                <strong>Panier :</strong>
                {% if user.cart %}
                    <span class="profile-badge">
                        Panier #{{ user.cart.id }} ({{ user.cart.products|length }} produits)
                    </span>
                {% else %}
                    <span class="profile-badge empty">
                        Pas de panier
                    </span>
                {% endif %}
            </p>
        </div>
    </div>

    {% if user.cart and user.cart.products|length > 0 %}
        <div class="cart-section">
            <h2 class="section-title">Mon panier</h2>

            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in user.cart.products %}
                        <tr>
                            <td>{{ product.name }}</td>
                            <td>{{ product.price }} €</td>
                            <td>
                                <form action="{{ path('cart_remove', {'id': product.id}) }}" method="post" onsubmit="return confirm('Retirer ce produit du panier ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove-from-cart-' ~ product.id) }}">
                                    <button type="submit" class="cart-remove-btn">
                                        Retirer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td><strong>Total :</strong></td>
                        <td colspan="2">
                            <strong>{{ user.cart.products|reduce((total, product) => total + product.price, 0) }} €</strong>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="cart-actions">
                <a href="{{ path('product_list') }}" class="profile-button">
                    Continuer mes achats
                </a>
            </div>
        </div>

    {% elseif user.cart %}
        <div class="profile-alert">
            Votre panier est vide.
            <a href="{{ path('product_list') }}">Continuer mes achats</a>
        </div>
    {% endif %}

    <div class="profile-actions">
        <a href="{{ path('user_edit', {'id': user.id}) }}" class="profile-button">
            Modifier mon profil
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('user_index') }}" class="profile-button secondary">
                ← Retour à la liste
            </a>
        {% endif %}
    </div>

</div>
{% endblock %}