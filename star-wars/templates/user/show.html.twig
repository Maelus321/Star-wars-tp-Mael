{# templates/user/show.html.twig #}
{% extends "base.html.twig" %}

{% block body %}
    <h1>Utilisateur : {{ user.username }}</h1>

    <p>ID : {{ user.id }}</p>
    <p>Username : {{ user.username }}</p>
    <p>Rôles : {{ user.roles|join(', ') }}</p>
    <p>Panier : 
        {% if user.cart %}
            Panier #{{ user.cart.id }} ({{ user.cart.products|length }} produits)
        {% else %}
            Pas de panier
        {% endif %}
    </p>

    <a href="{{ path('user_edit', {'id': user.id}) }}">Modifier</a>
    <a href="{{ path('user_index') }}">← Retour à la liste</a>
{% endblock %}