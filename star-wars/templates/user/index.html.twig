{% extends "base.html.twig" %}

{% block body %}
<div class="list-page">
    <h1 class="page-title">Users list</h1>
    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.username }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td class="table-actions">
                        <a href="{{ path('user_show', {'id': user.id}) }}" class="profile-button">See</a>
                        <a href="{{ path('user_edit', {'id': user.id}) }}" class="profile-button secondary">Modify</a>
                        <form method="post" action="{{ path('user_delete', {'id': user.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button type="submit" class="form-button delete-button">Delete</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="text-center">No users</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
