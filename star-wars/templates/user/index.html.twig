{# templates/user/index.html.twig #}
{% extends "base.html.twig" %}

{% block body %}
    <h1>Liste des utilisateurs</h1>

    <a href="{{ path('user_new') }}">Créer un utilisateur</a>

    {% for message in app.flashes('success') %}
        <div>{{ message }}</div>
    {% endfor %}

    <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Rôles</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                    <a href="{{ path('user_show', {'id': user.id}) }}">Voir</a>
                    <a href="{{ path('user_edit', {'id': user.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('user_delete', {'id': user.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit">Supprimer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4">Aucun utilisateur</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}