{# templates/user/edit.html.twig #}
{% extends "base.html.twig" %}

{% block body %}
    <h1>Modifier l'utilisateur : {{ user.username }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.username) }}
    {{ form_row(form.plainPassword) }}
    {{ form_row(form.roles) }}
    <button type="submit">Mettre à jour</button>
    {{ form_end(form) }}

    <a href="{{ path('user_show', {'id': user.id}) }}">Voir</a>
    {% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('user_index') }}">← Retour à la liste</a>
    {% endif %}


    <hr>
    <form method="post" action="{{ path('user_delete', {'id': user.id}) }}" onsubmit="return confirm('Supprimer ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
        <button type="submit">Supprimer</button>
    </form>
{% endblock %}