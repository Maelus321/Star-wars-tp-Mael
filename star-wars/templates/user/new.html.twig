{% extends 'base.html.twig' %}

{% block body %}
<div class="form-page">
    <div class="form-card">
        <h1 class="form-title">New user</h1>

        {{ form_start(form, {'attr': {'class': 'custom-form'}}) }}

            <div class="form-group">
                {{ form_label(form.username) }}
                {{ form_widget(form.username, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.username) }}
            </div>

            <div class="form-group">
                {{ form_label(form.plainPassword) }}
                {{ form_widget(form.plainPassword, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.plainPassword) }}
            </div>

            <div class="form-group">
                {{ form_label(form.roles) }}
                {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.roles) }}
            </div>

            <button type="submit" class="form-button">
                Signup
            </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
