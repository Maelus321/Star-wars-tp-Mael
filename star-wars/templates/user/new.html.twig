{% extends 'base.html.twig' %}

{% block body %}
    <h1>Créer un utilisateur</h1>
    {{ form_start(form) }}
        {{ form_row(form.username) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.roles) }}
        <button type="submit">Créer</button>
    {{ form_end(form) }}
{% endblock %}