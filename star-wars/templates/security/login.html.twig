{% extends 'base.html.twig' %}

{% block body %}

<div class="form-page">

    {% if error %}
        <div class="form-alert">
            {{ error.messageKey }}
        </div>
    {% endif %}

    <div class="form-card">
        <h1 class="form-title">Login</h1>

        <form method="post" action="{{ path('login') }}" class="custom-form">

            <div class="form-group">
                <label for="username">Username</label>
                <input type="text"
                       id="username"
                       name="_username"
                       value="{{ last_username }}"
                       class="form-input"
                       required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password"
                       id="password"
                       name="_password"
                       class="form-input"
                       required>
            </div>

            <button type="submit" class="form-button">
                Login
            </button>

        </form>
    </div>

</div>

{% endblock %}
