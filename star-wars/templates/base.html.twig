<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/7/75/Emblem_of_the_First_Galactic_Empire.svg">
        {% block stylesheets %}
        <link rel="stylesheet" href="/css/style.css">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>

        <div class="top-bar">
            <div class="logo-title">
                <p>STAR-WARS SHOP</p>
            </div>

           
            <div class="nav-buttons">
            <button><a href="{{ path('product_list') }}">Products</a></button>
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <button> <a href="{{ path('user_show', {'id': app.user.id}) }}">My account/Cart</a></button>
                <button><a href="{{ path('logout') }}">Logout</a></button>
            {% endif %}
            {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                <button><a href="{{ path('login') }}">Login</a></button>
                <button><a href="{{ path('user_new') }}">Signup</a></button>
            {% endif %}
            </div>

        </div>
        {% block body %}{% endblock %}
    </body>
</html>
