<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        <link rel="stylesheet" href="/css/style.css">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>

        <div class="top-bar">
            <div class="logo-title">
                <p>Star-Wars shop</p>
            </div>
            <div class="nav-buttons">
            
                <button><a href="{{ path('product_list') }}">Produits</a></button>
            </div>
            <div class="nav-buttons">
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <button> <a href="{{ path('user_show', {'id': app.user.id}) }}">My account/Cart</a></button>
                <button><a href="{{ path('logout') }}">Logout</a></button>
            {% endif %}
            {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                <button><a href="{{ path('login') }}">Login</a></button>
                <button><a href="{{ path('user_new') }}">Signup</a></button>
            {% endif %}
            </div>

        </div>
        {% block body %}{% endblock %}
    </body>
</html>
