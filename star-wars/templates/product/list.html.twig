{% extends "base.html.twig" %}

{% block body %}
    <div class="container">
        <h1>Every products</h1>

        <div class="filters">
            <select id="typeFilter" class="type-select">
                <option value="all">All</option>
                <option value="Ship">Ship</option>
                <option value="Droid">Droid</option>
                <option value="Vehicle">Vehicle</option>
                <option value="Weapon">Weapon</option>
                <option value="Kyber">Kyber Crystal</option>
            </select>
            
            <input 
                type="text" 
                id="searchInput" 
                placeholder="Search by name..."
                class="search-bar"
            >
        </div>

        {# Lien vers le formulaire de création #}
        {% if is_granted('ROLE_ADMIN') %}
            <a class="add-button" href="{{ path('new_product') }}">➕</a>
        {% endif %}

        {# Grille des produits #}
        <div class="products-grid" id="productsGrid">
            {% for product in products %}
                <div class="product-card" 
                     data-product-id="{{ product.id }}"
                     data-product-name="{{ product.name|lower }}"
                     data-product-category="{{ product.category ? product.category.name|lower : '' }}">
                    <a href="{{ path('product_show', {'id': product.id}) }}">
                        {# Image du produit #}
                        <div class="product-image">
                            <img src="{{ product.image }}" alt="{{ product.name }}">
                        </div>

                        {# Contenu de la carte #}
                        <div class="product-content">
                            {# Catégorie #}
                            {% if product.category %}
                                <span class="product-category">
                                    {{ product.category.name }}
                                </span>
                            {% endif %}

                            {# Nom et prix #}
                            <h3 class="product-title">{{ product.name }}</h3>
                            <div class="product-price">{{ product.price|number_format(2, ',', ' ') }} €</div>

                            {# Description (tronquée) #}
                            {% if product.description %}
                                <p class="product-description">
                                    {{ product.description|length > 100 ? product.description|slice(0, 100) ~ '...' : product.description }}
                                </p>
                            {% endif %}

                            {# Boutons d'action #}
                            <div class="product-actions">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <div class="admin-actions">
                                        <a href="{{ path('product_edit', {'id': product.id}) }}" 
                                           class="btn-edit" 
                                           title="Modifier">
                                            ✏️
                                        </a>
                                        <a href="{{ path('product_delete', {'id': product.id}) }}" 
                                           class="btn-delete" 
                                           onclick="return confirm('Voulez-vous vraiment supprimer {{ product.name }} ?')"
                                           title="Supprimer">
                                            🗑️
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                </div>
            {% else %}
                <div class="empty-state">
                    <p>No products.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="/js/product-filter.js"></script>
{% endblock %}
